<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- Top Space -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="30dp"/>

        <!-- Uploaded Image -->
        <ImageView
            android:id="@+id/imgNail"
            android:layout_width="320dp"
            android:layout_height="260dp"
            android:background="@drawable/image_border"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/analyze"/>

        <!-- Analysis Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="@drawable/analyze_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="25dp">

            <!-- Progress -->
            <ProgressBar
                android:id="@+id/progressAnalyze"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:indeterminate="true"/>

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Analyzing Image"
                android:textColor="#172B85"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Our AI is examining your nail"
                android:textColor="#808080"
                android:textSize="14sp"
                android:layout_marginBottom="25dp"/>

            <!-- Upload -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload"
                    android:textSize="18sp"
                    android:textColor="#4A4A4A"
                    android:layout_marginStart="15dp"/>
            </LinearLayout>

            <!-- Segmentation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Segmentation"
                    android:textSize="18sp"
                    android:textColor="#4A4A4A"
                    android:layout_marginStart="15dp"/>
            </LinearLayout>

            <!-- Classification -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Classification"
                    android:textSize="18sp"
                    android:textColor="#4A4A4A"
                    android:layout_marginStart="15dp"/>
            </LinearLayout>

            <!-- Severity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculating Severity"
                    android:textSize="18sp"
                    android:textColor="#4A4A4A"
                    android:layout_marginStart="15dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>