<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F4FF"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="30dp"
    android:paddingEnd="30dp">

    <!-- Top Space -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="70dp"/>

    <!-- Logo -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo"
        android:contentDescription="Logo"/>

    <!-- App Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NailDX"
        android:textColor="#2E5AAC"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"/>

    <!-- Space -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="40dp"/>

    <!-- Heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your first step toward&#10;better nail health."
        android:textAlignment="center"
        android:textColor="#222222"
        android:textSize="28sp"
        android:textStyle="bold"/>

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Nail Disease Detection"
        android:textColor="#8E8E8E"
        android:textSize="15sp"
        android:layout_marginTop="10dp"/>

    <!-- Space -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="45dp"/>

    <!-- Login Button -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/button_blue"
        android:text="LOGIN"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"/>

    <!-- Space Between Buttons -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="18dp"/>

    <!-- Register Button -->
    <Button
        android:id="@+id/btnCreateAccount"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/button_white"
        android:text="CREATE ACCOUNT"
        android:textAllCaps="false"
        android:textColor="#1F2D8C"
        android:textSize="16sp"/>

    <!-- Space -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="70dp"/>

    <!-- Bottom Text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="By continuing, you agree to our\nTerms &amp; Conditions and Privacy Policy"
        android:textColor="#9A9A9A"
        android:textSize="12sp"/>

</LinearLayout>