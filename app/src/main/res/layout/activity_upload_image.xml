<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/button_white"
                android:padding="10dp"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload Nail Image"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#243B8F"
                android:layout_marginStart="15dp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Take or select a clear photo of your nail"
            android:textAlignment="center"
            android:textColor="#8D8D8D"
            android:textSize="15sp"
            android:layout_marginTop="40dp"/>

        <!-- Tips -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Lighting -->

            <LinearLayout
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/button_white"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_camera"
                        android:contentDescription="Lighting"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Ensure Good&#10;Lighting"
                    android:textColor="#8A8A8A"
                    android:textSize="11sp"/>

            </LinearLayout>

            <!-- Center -->

            <LinearLayout
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/button_white"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_crop"
                        android:contentDescription="Center Nail"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Center Your&#10;Nail"
                    android:textColor="#8A8A8A"
                    android:textSize="11sp"/>

            </LinearLayout>

            <!-- Blur -->

            <LinearLayout
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/button_white"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_gallery"
                        android:contentDescription="Avoid Blur"/>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Avoid Blurry&#10;Images"
                    android:textColor="#8A8A8A"
                    android:textSize="11sp"/>

            </LinearLayout>

        </LinearLayout>
        <!-- Upload Card -->

        <LinearLayout
            android:id="@+id/uploadCard"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="35dp"
            android:background="#E8E9F8"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@android:drawable/stat_sys_upload"
                android:contentDescription="Upload"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to Upload"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JPG, PNG up to 10MB"
                android:textColor="#777777"
                android:textSize="12sp"/>

        </LinearLayout>
        <!-- Bottom Buttons -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnCamera"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_white"
                android:backgroundTint="@null"
                android:text="📷 Take Photo"
                android:textAllCaps="false"
                android:textColor="#233A8B"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnGallery"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/button_white"
                android:backgroundTint="@null"
                android:text="🖼 Gallery"
                android:textAllCaps="false"
                android:textColor="#233A8B"
                android:textStyle="bold"/>

        </LinearLayout>
        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:background="@drawable/button_blue"
            android:backgroundTint="@null"
            android:text="Analyze Image"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>

</ScrollView>